# =====================================================================
# FinSight AI - TokenOps governed agentic demo
# All settings are read by app/config.py (python-dotenv).
# Copy this file to .env and fill in your values.
# =====================================================================

# ---------- Azure OpenAI (Entra ID / RBAC - key auth is disabled) ----------
# Your identity (az login / managed identity) needs the
# "Cognitive Services OpenAI User" role on the Azure OpenAI resource.
AZURE_OPENAI_ENDPOINT=https://<your-aoai-resource>.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-12-01-preview
# Primary reasoning model (Azure deployment name)
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5.2-chat
# Cheaper model that TokenOps cost_guard downgrades to under budget pressure
AZURE_OPENAI_MINI_DEPLOYMENT=gpt-5-nano
# Optional: pin a tenant for DefaultAzureCredential (leave blank to use default)
AZURE_TENANT_ID=

# Pricing used by the TokenOps price book (USD per 1M tokens, per deployment)
PRICE_CHAT_INPUT_PER_1M=2.50
PRICE_CHAT_OUTPUT_PER_1M=10.00
PRICE_MINI_INPUT_PER_1M=0.15
PRICE_MINI_OUTPUT_PER_1M=0.60

# ---------- Azure AI Search (optional, RBAC) ----------
# Leave AZURE_SEARCH_ENDPOINT blank to use the local policy-document search fallback.
# Needs "Search Index Data Reader" (+ "Search Index Data Contributor" to push the index).
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_INDEX=finsight-policies

# ---------- TokenOps control plane (runs as a separate process) ----------
CONTROL_PLANE_HOST=127.0.0.1
CONTROL_PLANE_PORT=8800
CONTROL_PLANE_URL=http://127.0.0.1:8800
CONTROL_PLANE_DB=./data/tokenops/control_plane.db
# Leave blank for local demo (plane auth disabled). Set both for secured plane.
CONTROL_PLANE_API_KEYS=
CONTROL_PLANE_API_KEY=
# Governance policy file pushed to the plane at app start-up
TOKENOPS_GOVERNANCE_FILE=./config/governance.yaml
TOKENOPS_RESEED_ON_START=true
TOKENOPS_SERVICE=finsight-agent
# Default governance mode for runs: enforce | preview
TOKENOPS_MODE=enforce

# ---------- MCP servers (streamable HTTP) ----------
MCP_HOST=127.0.0.1
MCP_CORE_BANKING_PORT=8101
MCP_WEALTH_MARKETS_PORT=8102
MCP_RISK_COMPLIANCE_PORT=8103
MCP_ANALYTICS_PORT=8104

# ---------- Agent ----------
AGENT_MAX_ITERATIONS=12
# Leave blank for GPT-5 / o-series deployments (they only accept the default temperature)
AGENT_TEMPERATURE=

# ---------- Evaluation (LLM-as-judge, runs after each completed run) ----------
EVAL_ENABLED=true
# Blank = AZURE_OPENAI_MINI_DEPLOYMENT. Eval cost is shown on the trace, not charged to the run budget.
EVAL_DEPLOYMENT=

# ---------- LangSmith ONLINE evaluation (second evaluator, runs after LLM-as-judge) ----------
# Every agent run is traced live to the LangSmith tracing project LANGSMITH_PROJECT (LLM calls, MCP tools).
# Online evaluators (openevals LLM judges on EVAL_DEPLOYMENT + code evaluators) then score that production
# trace and attach the scores as feedback on the run (LangSmith > Tracing project > Feedback / Monitoring).
# Leave LANGSMITH_API_KEY blank to skip LangSmith tracing + evaluation.
LANGSMITH_EVAL_ENABLED=true
LANGSMITH_API_KEY=
# US: https://api.smith.langchain.com  |  EU: https://eu.api.smith.langchain.com
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Optional: only needed when the API key has access to more than one workspace
LANGSMITH_WORKSPACE_ID=
# Tracing project that receives the production traces and online-evaluation feedback (created automatically)
LANGSMITH_PROJECT=finsight-agent
# Fraction of completed runs scored by the online evaluators (1.0 = every run, 0.25 = one in four)
LANGSMITH_SAMPLING_RATE=1.0
# Keep false: FinSight opens the LangSmith trace itself for each governed run
LANGSMITH_TRACING=false

# ---------- App ----------
APP_HOST=127.0.0.1
APP_PORT=8000
DATA_DIR=./data
LOG_LEVEL=INFO
